# fstack per-repo config (key=value, read as data). Synced to .fstack/config once; yours to edit.
# Harness adapters to generate: claude-code codex cursor
harnesses=claude-code codex cursor
# Gate modes: off | observe | enforce. Start in observe; promote one gate at a time.
gate.max-lines=observe
gate.doc-ratio=observe
gate.new-files=observe
gate.removed=observe
gate.secrets=observe
gate.stamp=observe
max-lines=400
doc-ratio=0.5
doc-ratio-min=20
md-allowlist=README.md AGENTS.md SKILL.md INDEX.md
# Set to your ADR folder if the repo keeps ADRs, e.g. docs/adr
adr-dir=
